---
import Wordmark from './Wordmark.astro';
const horizon = (await import('../../public/brand/horizon.svg?raw')).default.replace('<svg ', '<svg class="horizon-star" aria-hidden="true" ');
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/rocio-formentin/' },
  { label: 'Behance', href: 'https://www.behance.net/rformentin' },
  { label: 'Contra', href: 'https://contra.com/andromeda_journey' },
];
---
<footer class="site" id="contact">
  <div class="wrap">
    <div class="grid contact">
      <p class="mono muted label reveal">04 / Contact</p>
      <h2 class="prop q reveal" style="--d:80ms">A brand, a product, or a problem somewhere in between?</h2>
      <div class="meta reveal" style="--d:160ms">
        <p class="lead">Open to full-time roles and selected projects. Working remotely from Argentina.</p>
        <a class="mail ul" href="mailto:rocio@andromedajourney.com">rocio@andromedajourney.com <span aria-hidden="true">↗</span></a>
        <ul class="mono-nav socials">
          {links.map((l) => <li><a class="ul" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>)}
          <li><a class="ul" href="/rocio-formentin-cv.pdf">CV ↓</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="horizon">
    <p class="mono muted top reveal"><span class="sky">*</span><br />something stellar's on the horizon, enjoy the journey</p>
    <div class="sign reveal" style="--d:120ms">
      <Wordmark width={220} />
      <p class="mono">Creative lab <span class="muted">:</span><br />Born from imagination</p>
      <p class="mono muted">© 2026 Rocío Formentin</p>
    </div>
    <div class="star-wrap" set:html={horizon} />
    <div class="wrap coords mono muted">
      <span>ARG / UTC−03</span>
      <a class="ul" href="#main">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: var(--bone); --fg: var(--bone); --muted: var(--stone); --rule: rgba(221,218,218,.18); --accent: var(--sky); }
  .contact { padding: 160px 0 120px; row-gap: 32px; border-top: 1px solid var(--rule); }
  .label { grid-column: 1 / span 3; margin: 6px 0 0; }
  .q { grid-column: 4 / span 6; margin: 0; color: var(--paper); }
  .meta { grid-column: 4 / span 6; display: grid; gap: 28px; }
  .meta .lead { margin: 0; max-width: 34ch; }
  .mail { font-size: clamp(22px, 2.2vw, 30px); color: var(--paper); justify-self: start; }
  .socials { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 28px; color: var(--paper); }

  .horizon { position: relative; height: min(100vh, 980px); overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .top { margin: 64px 0 0; letter-spacing: .04em; text-transform: none; font-size: 14px; }
  .sky { color: var(--sky); font-size: 18px; }
  .sign { margin-top: auto; margin-bottom: 30vh; display: grid; gap: 18px; justify-items: start; text-align: left; color: var(--bone); }
  .sign :global(.wordmark path) { vector-effect: non-scaling-stroke; stroke-width: 1px; }
  .sign p { margin: 0; color: var(--paper); font-size: 12px; }
  .star-wrap { position: absolute; left: 50%; bottom: 0; width: min(426px, 70vw); aspect-ratio: 1; transform: translate(-50%, 50%); color: var(--sky); }
  .star-wrap :global(.horizon-star) { width: 100%; height: 100%; animation: spin 90s linear infinite; }
  .coords { position: absolute; bottom: 40px; left: 0; right: 0; display: flex; justify-content: space-between; gap: 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 860px) {
    .contact { padding: 96px 0 72px; }
    .label, .q, .meta { grid-column: 1 / -1; }
    .coords { flex-direction: column; align-items: flex-start; bottom: 24px; }
    .coords span:nth-child(2) { display: none; }
  }
</style>
