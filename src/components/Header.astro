---
const { crumbs = [{ label: '01 / Origin', href: '/' }] } = Astro.props;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#practice', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="site">
  <div class="bar">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          {c.href ? <a class="ul" href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </>
      ))}
    </nav>
    <a href="/" class="north" aria-label="Andromeda — home"><svg class="star" aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14.000,0.500 L14.643,12.448 L23.546,4.454 L15.552,13.357 L27.500,14.000 L15.552,14.643 L23.546,23.546 L14.643,15.552 L14.000,27.500 L13.357,15.552 L4.454,23.546 L12.448,14.643 L0.500,14.000 L12.448,13.357 L4.454,4.454 L13.357,12.448 Z" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/></svg></a>
    <nav class="links mono" aria-label="Main">
      {links.map((l) => <a class="ul" href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <hr class="rule" />
</header>

<style>
  .site { max-width: var(--maxw); margin: 0 auto; padding: 51px var(--margin) 0; }
  .bar { display: grid; grid-template-columns: 1fr 28px 1fr; align-items: start; height: 28px; margin-bottom: 23px; }
  .crumbs { color: var(--muted); letter-spacing: .02em; line-height: 20px; display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs [aria-current] { color: var(--muted); }
  .north { color: var(--fg); opacity: .8; width: 28px; height: 28px; }
  .north :global(.star) { width: 28px; height: 28px; }
  .links { justify-self: end; display: flex; gap: 33px; color: var(--fg-strong); line-height: 20px; letter-spacing: .015em; }
  @media (max-width: 860px) {
    .site { padding-top: 24px; }
    .bar { grid-template-columns: 1fr auto; margin-bottom: 18px; }
    .north { display: none; }
    .links { gap: 18px; }
  }
</style>
