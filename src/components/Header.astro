---
import Wordmark from './Wordmark.astro';
const { section } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#practice', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="site wrap">
  <div class="bar">
    <a href="/" class="home" aria-label="Andromeda — home"><Wordmark width={197} /></a>
    <a href="/" class="north" aria-hidden="true" tabindex="-1"><svg class="star" aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.1436 12.4736L14.1973 13.5225L14.9775 12.8193L17.0449 10.9541L15.1807 13.0225L14.4775 13.8027L15.5264 13.8564L18.3066 14L15.5264 14.1436L14.4775 14.1973L15.1807 14.9775L17.0449 17.0449L14.9775 15.1807L14.1973 14.4775L14.1436 15.5264L14 18.3066L13.8564 15.5264L13.8027 14.4775L13.0225 15.1807L10.9541 17.0449L12.8193 14.9775L13.5225 14.1973L12.4736 14.1436L9.69238 14L12.4736 13.8564L13.5225 13.8027L12.8193 13.0225L10.9541 10.9541L13.0225 12.8193L13.8027 13.5225L13.8564 12.4736L14 9.69238L14.1436 12.4736Z" stroke="currentColor"/></svg></a>
    <nav class="mono-nav" aria-label="Main">
      {links.map((l) => <a class="ul" href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <hr class="rule draw in" />
  <p class="mono muted index" data-section>{section}</p>
</header>

<style>
  .site { padding-top: 48px; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding-bottom: 22px; }
  .home { color: var(--fg); justify-self: start; }
  .home :global(.wordmark) { width: 197px; height: auto; }
  .home :global(.wordmark path) { vector-effect: non-scaling-stroke; stroke-width: 1px; }
  .north { color: var(--fg); opacity: .85; }
  .north :global(.star) { width: 28px; height: 28px; animation: north 40s linear infinite; }
  nav { justify-self: end; display: flex; gap: 40px; color: var(--fg-strong); }
  .index { margin: 56px 0 0; }
  @keyframes north { to { transform: rotate(360deg); } }
  @media (max-width: 860px) {
    .site { padding-top: 24px; }
    .home :global(.wordmark) { width: 132px; }
    .north { display: none; }
    .bar { grid-template-columns: 1fr auto; }
    nav { gap: 18px; }
    .index { margin-top: 32px; }
  }
</style>
